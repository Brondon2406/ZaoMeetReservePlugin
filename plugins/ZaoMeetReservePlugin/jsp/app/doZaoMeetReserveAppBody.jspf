<% 
if(loggedMember==null){
	sendRedirect(jcmsContext.getBaseUrl());
}
%>
	<%@ page contentType="text/html; charset=UTF-8" %>
	
	<% if (appHandler.showMyReservationsView()) { %>
	    <%@ include file='/plugins/ZaoMeetReservePlugin/jsp/app/views/doMyReservationsView.jspf' %>
	
	<% } else if (appHandler.showAllReservationsView()) { %>
	    <%@ include file='/plugins/ZaoMeetReservePlugin/jsp/app/views/doAllReservationsView.jspf' %>
	
	<% } else if (appHandler.showCalendarView()) { %>
	    <%@ include file='/plugins/ZaoMeetReservePlugin/jsp/app/views/doCalendarView.jspf' %>
	
	<% } else if (appHandler.showRoomDetailItem()) { %>
	    <%@ include file='/plugins/ZaoMeetReservePlugin/jsp/app/views/doRoomDetailView.jspf' %>
	
	<% } else if (appHandler.showAllRoomsView()) { %>
	    <%@ include file='/plugins/ZaoMeetReservePlugin/jsp/app/views/doAllRoomsView.jspf' %>
	
	<% } else if (appHandler.showToValidateView()) { %>
	    <%@ include file='/plugins/ZaoMeetReservePlugin/jsp/app/views/doToValidateView.jspf' %>
	
	<% } else if (appHandler.showDashboardView()) { %>
	    <%@ include file='/plugins/ZaoMeetReservePlugin/jsp/app/views/doDashboardView.jspf' %>
	
	<% } else if (appHandler.showAdminView() || appHandler.showAdminRoomsView() || appHandler.showAdminConfigView()) { %>
	    <%@ include file='/plugins/ZaoMeetReservePlugin/jsp/app/views/doAdminView.jspf' %>
	
	<% } %>